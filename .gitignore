# --------------------------------------------------
# Arcana Pulse / Arcana Credit Union
# Next.js + TypeScript + Node + Vercel
# Sandbox fintech app with Appwrite / Plaid / Dwolla / Sentry
# --------------------------------------------------

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build output
/.next/
/out/
/build/
/dist/
/coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Runtime / temp files
tmp/
temp/
.cache/
.eslintcache
*.pid
*.seed
*.pid.lock

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Keep safe templates committed
!.env.example
!.env.schema
!.env.sample

# Security / certificates / keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.asc
*.ovpn

# Vercel
.vercel

# Sentry local files
.sentryclirc

# Testing artifacts
/playwright-report/
/test-results/
/blob-report/
.nyc_output/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.iml

# Local databases / dumps / exports
*.sqlite
*.sqlite3
*.db
*.bak
*.dump

# Archives
*.zip
*.tar
*.tgz
*.gz
*.7z
*.rar

# Uploaded/generated assets you probably do not want in git
/public/uploads/
/uploads/

# Optional local agent scratchpads
.claude/
.cursor/
.antigravity/

# --------------------------------------------------
# Intentionally DO NOT ignore these:
# - docs/
# - AGENTS.md
# - .agents/
# - PRDs and architecture docs
# - package-lock.json / pnpm-lock.yaml / yarn.lock
# --------------------------------------------------
