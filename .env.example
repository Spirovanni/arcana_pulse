# Arcana Pulse Environment Variables
# Copy to .env.local and fill in values

# Plaid (sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Dwolla (sandbox)
DWOLLA_KEY=
DWOLLA_SECRET=
DWOLLA_ENV=sandbox
DWOLLA_WEBHOOK_SECRET=

# Appwrite
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=arcana_pulse
# Optional explicit collection id for persisted AI token usage
APPWRITE_AI_USAGE_COLLECTION_ID=aiUsage
# Optional explicit collection id for persisted AI analytical reports
APPWRITE_AI_REPORTS_COLLECTION_ID=aiReports
# Optional explicit collection id for persisted credit monitoring history
APPWRITE_CREDIT_MONITORING_COLLECTION_ID=creditMonitoring

# Anthropic AI (transaction categorization)
ANTHROPIC_API_KEY=

# ElevenLabs voice advisor (server-side only)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_DEFAULT_MODEL_ID=eleven_turbo_v2

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
MOBILE_AUTH_SECRET=
# Platform admin gating for /admin routes
ADMIN_USER_IDS=
ADMIN_EMAILS=

# Field-level encryption (AES-256-GCM)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Email (Resend)
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Stripe subscription billing
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook secret — from: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Create products in Stripe dashboard and paste the recurring price IDs here
STRIPE_PRO_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
